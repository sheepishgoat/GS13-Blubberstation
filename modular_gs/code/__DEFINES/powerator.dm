/// The amount of money all powerators can make for the cargo budget each round without incuring a penalty
#define POWERATOR_MONEY_LIMIT 70000
/// The maximum cash bonus the powerator gets when it wasn't exceeding the money limit
#define POWERATOR_MAXIMUM_BONUS 1.3
/// The maximum cash penalty the powerator gets when it has exceeded the money limit
#define POWERATOR_MAXIMUM_PENALTY 0.01
